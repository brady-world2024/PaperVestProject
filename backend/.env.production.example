# Production backend runtime configuration template.
# Use your deployment platform or secret manager as the real runtime source of truth.
# This file is a documented example, not a committed secret store.

PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://prod-postgres.internal:5432/papervest
SPRING_DATASOURCE_USERNAME=papervest
SPRING_DATASOURCE_PASSWORD=replace-with-production-db-password

SPRING_RABBITMQ_HOST=prod-rabbitmq.internal
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=papervest
SPRING_RABBITMQ_PASSWORD=replace-with-production-rabbitmq-password

APP_JWT_SECRET=replace-with-a-long-random-production-secret
APP_ACCESS_TOKEN_TTL=PT15M
APP_REFRESH_TOKEN_TTL=P30D
APP_INITIAL_CASH=100000.00
APP_WEB_BASE_URL=https://papervest.example
APP_EMAIL_VERIFICATION_TOKEN_TTL=P2D
APP_PASSWORD_RESET_TOKEN_TTL=PT1H
APP_BOOTSTRAP_ADMIN_EMAILS=admin@papervest.example

APP_ALLOWED_ORIGINS=https://papervest.example,https://app.papervest.example
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAME_SITE=Lax
APP_AUTH_RATE_LIMIT_ENABLED=true
APP_AUTH_RATE_LIMIT_WINDOW=PT10M
APP_AUTH_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
APP_AUTH_RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
APP_AUTH_RATE_LIMIT_PASSWORD_RESET_REQUEST_MAX_ATTEMPTS=5
APP_AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_MAX_ATTEMPTS=10
APP_AUTH_RATE_LIMIT_EMAIL_VERIFICATION_CONFIRM_MAX_ATTEMPTS=10

MARKETDATA_PROVIDER=FINNHUB
MARKETDATA_QUOTE_CACHE_TTL=PT30S
MARKETDATA_QUOTE_STALE_GRACE_TTL=PT15M
MARKETDATA_HISTORY_CACHE_TTL=PT5M
MARKETDATA_HISTORY_STALE_GRACE_TTL=P1D
MARKETDATA_SEARCH_CACHE_TTL=PT5M
MARKETDATA_SEARCH_STALE_GRACE_TTL=PT30M
MARKETDATA_ALLOW_PARTIAL_HOME_RESULTS=true
FINNHUB_API_KEY=replace-with-production-finnhub-api-key
FINNHUB_BASE_URL=https://finnhub.io/api/v1

APP_CONDITIONAL_ORDERS_SCHEDULER_ENABLED=true
APP_CONDITIONAL_ORDERS_LISTENER_ENABLED=true

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_PAPERVEST=INFO
SPRING_PROFILES_ACTIVE=json-logs
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ADDITIONAL_PATHS=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_ENDPOINT_HEALTH_SHOW_COMPONENTS=never
